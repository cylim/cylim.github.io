{
  "name": "cy-my",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "cy.my: an ink-wash walk into the mist, built with React Three Fiber",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/render-articles.mjs && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src scripts tests",
    "test": "vitest",
    "e2e": "playwright test",
    "shots": "node scripts/shots.mjs",
    "gen:terms": "node scripts/build-terms.mts",
    "gen:fonts": "node scripts/subset-fonts.mjs",
    "check:glyphs": "node scripts/check-glyphs.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "prune:dist": "node scripts/prune-dist.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "lenis": "^1.3.26",
    "maath": "^0.10.8",
    "postprocessing": "~6.39.5",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "three": "~0.186.1",
    "troika-three-text": "^0.52.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "~1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/three": "~0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "marked": "^18.0.14",
    "oxlint": "^1.85.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "tyme4ts": "~1.5.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
